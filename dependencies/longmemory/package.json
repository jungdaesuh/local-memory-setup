{
  "name": "longmemory",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/stores/sqlite',{recursive:true});fs.copyFileSync('src/stores/sqlite/schema.sql','dist/stores/sqlite/schema.sql')\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1093.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.11.1",
    "mammoth": "1.12.0",
    "pdf-parse": "2.4.5",
    "stemmer": "2.0.1",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@types/turndown": "5.0.6",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "ip-address": "10.7.1",
    "hono": "4.13.5",
    "@hono/node-server": "1.19.15",
    "qs": "6.16.0",
    "@xmldom/xmldom": "0.8.15"
  }
}
